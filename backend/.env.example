# Copy to `.env` and fill in real values. Never commit secrets.

# Required: Claude AI for intake conversation + KG-guided responses
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: when heuristics return English, call Haiku for ISO 639-1 (adds latency/cost; set 1 only if needed)
USE_CLAUDE_LANG_DETECT=0

# Required: OpenAI for Whisper multilingual STT (/caller/stt)
OPENAI_API_KEY=your_openai_api_key_here

# Required: ElevenLabs for natural TTS on web caller + Twilio phone calls
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Required for phone calls: Twilio voice
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14788125405
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

# Redis for browser STT transcript persistence (no longer optional)
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Database — SQLite for local dev; PostgreSQL for production (run `alembic upgrade head`)
DATABASE_URL=sqlite:///./telehealth.db
#
# Supabase: use Project Settings → Database → Connection string → URI (postgresql:// or postgres://).
# Do NOT use https://xxxx.supabase.co — that is the REST API, not Postgres.
# Optional: DB_SSLMODE=require if your host requires explicit SSL in connect_args.
#
# On PostgreSQL, tables are created by Alembic only (init_db skips create_all).
# DB_ALLOW_CREATE_ALL=1  # optional: force SQLAlchemy create_all on Postgres (not recommended)

# Recommended: faster startup on Render (skip WHO/ICD enrichment pipeline)
SKIP_PIPELINE_ENRICHMENT=1

# Demo mode (bypasses auth; set to 0 for production)
DEMO_MODE=1

# API auth (when DEMO_MODE=0): comma-separated keys OR sha256 hex hashes
# API_KEYS=secret1,secret2
# API_KEY_HASHES=abc...def,...

# Twilio webhook validation — must match the URL configured in Twilio console
# PUBLIC_BASE_URL=https://your-service.onrender.com
# SKIP_TWILIO_SIGNATURE=1

# Optional observability
# SENTRY_DSN=
# DATA_PURGE_ENABLED=0

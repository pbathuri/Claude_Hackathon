# Copy to `.env` and fill in real values. Never commit secrets.

# Required: Claude AI for intake conversation + KG-guided responses
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: ElevenLabs for natural TTS on web caller + Twilio phone calls
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Required for phone calls: Twilio voice
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14788125405
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

# Redis for browser STT transcript persistence (no longer optional)
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Database (SQLite for hackathon; PostgreSQL for production)
DATABASE_URL=sqlite:///./telehealth.db

# Recommended: faster startup on Render (skip WHO/ICD enrichment pipeline)
SKIP_PIPELINE_ENRICHMENT=1

# Demo mode (bypasses auth; set to 0 for production)
DEMO_MODE=1
